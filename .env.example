# =============================================================================
# LitNexus Environment Configuration
# Copy this file to .env and fill in your credentials. Never commit .env!
# =============================================================================

# App
APP_NAME=LitNexus
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=change-this-to-a-strong-random-64-char-hex-string
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# PostgreSQL + pgvector
POSTGRES_USER=litnexus
POSTGRES_PASSWORD=litnexus_dev_pass
POSTGRES_DB=litnexus
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://litnexus:litnexus_dev_pass@localhost:5432/litnexus

# Centralized LLM Router (LiteLLM)
# Primary & Fallback order (comma-separated LiteLLM model identifiers)
LLM_PRIMARY_MODEL=gemini/gemini-2.5-flash
LLM_FALLBACK_MODELS=openai/gpt-4o-mini
LLM_EMBEDDING_MODEL=text-embedding-3-small
LLM_TEMPERATURE=0.2

# Provider API Keys (configure at least one)
GEMINI_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=

# Academic Search (OpenAlex is free; optional email gives faster Polite Pool access)
OPENALEX_MAILTO=
SEMANTIC_SCHOLAR_API_KEY=

# Frontend
VITE_API_URL=http://localhost:8000/api/v1
